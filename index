/* =====================================================
   8. LIVE DEMO CHART (canvas, no library)
   ===================================================== */
const canvas = document.getElementById('chartCanvas');
const ctx = canvas.getContext('2d');
let chartType = 'bar';
const growthSlider = document.getElementById('growthSlider');
const pointsSlider = document.getElementById('pointsSlider');
const growthVal = document.getElementById('growthVal');
const pointsVal = document.getElementById('pointsVal');

function getStyleColor(varName){
  return getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
}

function genData(points, growth){
  let val = 100; const arr=[];
  for(let i=0;i<points;i++){
    arr.push(Math.max(val,5));
    val = val * (1 + growth/100) + (Math.random()*14-7);
  }
  return arr;
}

function drawChart(){
  const points = parseInt(pointsSlider.value,10);
  const growth = parseInt(growthSlider.value,10);
  growthVal.textContent = growth + '%';
  pointsVal.textContent = points;
  const data = genData(points, growth);
  const w = canvas.width, h = canvas.height, pad = 34;
  ctx.clearRect(0,0,w,h);
  const maxV = Math.max(...data) * 1.15;
  const accent = getStyleColor('--accent') || '#2DD4BF';
  const accent2 = getStyleColor('--accent-2') || '#F5A623';
  const dim = getStyleColor('--text-dim') || '#8A96AC';

  // gridlines
  ctx.strokeStyle = 'rgba(128,128,128,0.15)';
  ctx.lineWidth = 1;
  for(let g=0; g<=4; g++){
    const y = pad + (h-2*pad)*g/4;
    ctx.beginPath(); ctx.moveTo(pad,y); ctx.lineTo(w-pad,y); ctx.stroke();
  }

  const stepX = (w - 2*pad) / (data.length-1 || 1);

  if(chartType === 'bar'){
    const bw = stepX*0.5;
    data.forEach((v,i)=>{
      const x = pad + i*stepX - bw/2 + stepX/2 - stepX/2;
      const barX = pad + i*stepX - bw/2;
      const barH = (v/maxV)*(h-2*pad);
      const grad = ctx.createLinearGradient(0,h-pad-barH,0,h-pad);
      grad.addColorStop(0,accent); grad.addColorStop(1,accent2);
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.roundRect ? ctx.roundRect(barX, h-pad-barH, bw, barH, 4) : ctx.rect(barX,h-pad-barH,bw,barH);
      ctx.fill();
    });
  } else {
    ctx.beginPath();
    data.forEach((v,i)=>{
      const x = pad + i*stepX; const y = h-pad-(v/maxV)*(h-2*pad);
      if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    });
    ctx.strokeStyle = accent; ctx.lineWidth = 2.5; ctx.stroke();
    data.forEach((v,i)=>{
      const x = pad + i*stepX; const y = h-pad-(v/maxV)*(h-2*pad);
      ctx.beginPath(); ctx.arc(x,y,4,0,Math.PI*2); ctx.fillStyle = accent2; ctx.fill();
    });
  }

  // month labels
  ctx.fillStyle = dim; ctx.font = '11px Inter, sans-serif'; ctx.textAlign='center';
  data.forEach((v,i)=>{
    const x = pad + i*stepX;
    ctx.fillText('M'+(i+1), x, h-10);
  });
}
document.querySelectorAll('.chip-toggle button').forEach(btn=>{
