<!DOCTYPE html>
<!--
  ===================================================================
  DATA ANALYST PORTFOLIO — single file (HTML + CSS + JS)
  ===================================================================
  HOW TO MAKE THIS YOURS — search for these placeholders and swap them:
    "Aarav Sharma"          -> your name (appears ~4 times)
    "aarav.analyst@mail.com"-> your email
    "your-username"         -> your GitHub username (in links)
    "your-linkedin"         -> your LinkedIn handle
    "resume.pdf"            -> upload your actual resume file with this
                               exact name next to index.html, or edit
                               the href in the "Download Resume" buttons
    PROJECTS array (in <script> near the bottom)   -> your real projects
    SKILLS, EDUCATION, JOURNEY arrays (same script) -> your real details
    Contact form currently opens the user's email app (mailto:). To make
    it submit silently instead, connect it to a form service such as
    Formspree and change the <form action="..."> line — the comment
    right above the <form> tag shows exactly where.
  ===================================================================
-->
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aarav Sharma · Data Analyst</title>
<meta name="description" content="Portfolio of Aarav Sharma, PW Skills certified Data Analyst — skills, projects, and a live interactive demo.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📊</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* =================== TOKENS =================== */
:root{
  --bg:#0B1220;
  --bg-elev:#121B2E;
  --bg-elev-2:#17213A;
  --text:#E8EDF5;
  --text-dim:#8A96AC;
  --accent:#2DD4BF;
  --accent-rgb:45,212,191;
  --accent-2:#F5A623;
  --accent-2-rgb:245,166,35;
  --border:rgba(232,237,245,0.09);
  --shadow: 0 20px 60px rgba(0,0,0,0.35);
  --radius: 14px;
  --font-display:'Space Grotesk', sans-serif;
  --font-body:'Inter', sans-serif;
  --font-mono:'JetBrains Mono', monospace;
}
html[data-theme="light"]{
  --bg:#F3F6F8;
  --bg-elev:#FFFFFF;
  --bg-elev-2:#EAEFF3;
  --text:#101826;
  --text-dim:#5B6675;
  --accent:#0C948A;
  --accent-rgb:12,148,138;
  --accent-2:#C77700;
  --accent-2-rgb:199,119,0;
  --border:rgba(16,24,38,0.09);
  --shadow: 0 20px 50px rgba(16,24,38,0.10);
}

*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--font-body);
  line-height:1.6;
  overflow-x:hidden;
  transition:background .4s ease, color .4s ease;
  cursor:none;
}
a{color:inherit;text-decoration:none;}
ul{list-style:none;}
button{font-family:inherit;cursor:none;border:none;background:none;color:inherit;}
img{max-width:100%;display:block;}
section{padding:120px 8vw;position:relative;}
.eyebrow{
  font-family:var(--font-mono);
  font-size:.78rem;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:var(--accent);
  display:inline-flex;
  align-items:center;
  gap:10px;
  margin-bottom:18px;
}
.eyebrow::before{content:"";width:24px;height:1px;background:var(--accent);}
h1,h2,h3{font-family:var(--font-display);letter-spacing:-0.01em;}
.section-title{font-size:clamp(1.8rem,3.4vw,2.6rem);font-weight:600;margin-bottom:14px;}
.section-sub{color:var(--text-dim);max-width:560px;margin-bottom:56px;font-size:1rem;}
::selection{background:rgba(var(--accent-rgb),.35);color:var(--text);}

/* custom scrollbar */
::-webkit-scrollbar{width:11px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:linear-gradient(var(--accent),var(--accent-2));border-radius:20px;border:3px solid var(--bg);}
*{scrollbar-width:thin;scrollbar-color:var(--accent) var(--bg);}

/* =================== CUSTOM CURSOR =================== */
.cursor-dot,.cursor-ring{position:fixed;top:0;left:0;pointer-events:none;z-index:9999;border-radius:50%;transform:translate(-50%,-50%);}
.cursor-dot{width:7px;height:7px;background:var(--accent);transition:opacity .2s;}
.cursor-ring{width:34px;height:34px;border:1.5px solid rgba(var(--accent-rgb),.55);transition:width .18s,height .18s,border-color .18s,opacity .2s;}
.cursor-ring.grow{width:56px;height:56px;border-color:var(--accent-2);background:rgba(var(--accent-2-rgb),.08);}
@media (hover:none), (pointer:coarse){
  .cursor-dot,.cursor-ring{display:none;}
  body,button,a{cursor:auto;}
}

/* =================== NAV =================== */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:900;
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 8vw;
  backdrop-filter:blur(10px);
  background:rgba(11,18,32,.55);
  border-bottom:1px solid var(--border);
  transition:background .4s ease, border-color .4s ease;
}
html[data-theme="light"] .nav{background:rgba(243,246,248,.7);}
.logo{font-family:var(--font-mono);font-weight:600;font-size:1rem;letter-spacing:.04em;}
.logo span{color:var(--accent);}
.nav-links{display:flex;gap:34px;align-items:center;}
.nav-links a{font-size:.88rem;color:var(--text-dim);position:relative;padding:4px 0;transition:color .25s;}
.nav-links a::after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:1.5px;background:var(--accent);transition:width .25s;}
.nav-links a:hover,.nav-links a.active{color:var(--text);}
.nav-links a.active::after,.nav-links a:hover::after{width:100%;}
.nav-actions{display:flex;align-items:center;gap:16px;}
.theme-toggle{
  width:52px;height:28px;border-radius:20px;background:var(--bg-elev-2);
  border:1px solid var(--border);position:relative;flex-shrink:0;
}
.theme-toggle .knob{
  position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;
  background:var(--accent);transition:transform .3s ease;
  display:flex;align-items:center;justify-content:center;font-size:11px;
}
html[data-theme="light"] .theme-toggle .knob{transform:translateX(24px);}
.btn{
  font-size:.85rem;font-weight:600;padding:11px 20px;border-radius:9px;
  display:inline-flex;align-items:center;gap:8px;transition:transform .25s,box-shadow .25s,background .25s;
}
.btn-primary{background:var(--accent);color:#06181A;}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(var(--accent-rgb),.35);}
.btn-ghost{border:1px solid var(--border);color:var(--text);}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent);}
.nav-resume{display:none;}
@media(min-width:880px){.nav-resume{display:inline-flex;}}
.burger{display:none;width:38px;height:38px;border:1px solid var(--border);border-radius:8px;align-items:center;justify-content:center;}
@media(max-width:879px){
  .nav-links{position:fixed;top:64px;left:0;right:0;background:var(--bg-elev);flex-direction:column;padding:24px 8vw;gap:20px;border-bottom:1px solid var(--border);transform:translateY(-130%);opacity:0;transition:transform .35s ease, opacity .3s;}
  .nav-links.open{transform:translateY(0);opacity:1;}
  .burger{display:flex;}
}

/* =================== HERO =================== */
.hero{
  min-height:100vh;display:flex;align-items:center;
  padding-top:120px;
  background:
    radial-gradient(600px 380px at 88% 18%, rgba(var(--accent-rgb),.10), transparent 60%),
    radial-gradient(500px 320px at 6% 90%, rgba(var(--accent-2-rgb),.08), transparent 60%);
}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center;width:100%;}
@media(max-width:960px){.hero-grid{grid-template-columns:1fr;}}
.hero h1{font-size:clamp(2.2rem,5vw,3.6rem);font-weight:700;line-height:1.08;margin-bottom:18px;}
.hero h1 em{font-style:normal;color:var(--accent);}
.hero p.lede{color:var(--text-dim);max-width:480px;font-size:1.05rem;margin-bottom:34px;}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:56px;}
.stat-row{display:flex;gap:38px;flex-wrap:wrap;}
.stat b{display:block;font-family:var(--font-mono);font-size:1.7rem;color:var(--text);}
.stat span{font-size:.78rem;color:var(--text-dim);letter-spacing:.03em;}

/* terminal / signature element */
.terminal{
  background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius);
  box-shadow:var(--shadow);overflow:hidden;
}
.terminal-bar{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg-elev-2);}
.terminal-bar span{width:10px;height:10px;border-radius:50%;background:var(--text-dim);opacity:.4;}
.terminal-bar b{margin-left:8px;font-family:var(--font-mono);font-size:.72rem;color:var(--text-dim);font-weight:500;}
.terminal-body{padding:22px 22px 26px;font-family:var(--font-mono);font-size:.86rem;min-height:280px;}
.terminal-body .prompt{color:var(--accent-2);}
#query-line{color:var(--text);white-space:pre-wrap;}
#query-line .cur{display:inline-block;width:7px;background:var(--accent);animation:blink 1s step-end infinite;}
@keyframes blink{50%{opacity:0;}}
.result-table{margin-top:16px;width:100%;border-collapse:collapse;font-size:.78rem;opacity:0;transform:translateY(6px);transition:opacity .5s ease, transform .5s ease;}
.result-table.show{opacity:1;transform:none;}
.result-table th{text-align:left;color:var(--text-dim);font-weight:500;padding:6px 10px 8px;border-bottom:1px solid var(--border);}
.result-table td{padding:7px 10px;border-bottom:1px solid var(--border);}
.result-table .bar{height:5px;border-radius:3px;background:linear-gradient(90deg,var(--accent),var(--accent-2));}

/* =================== ABOUT =================== */
.about-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:60px;align-items:start;}
@media(max-width:820px){.about-grid{grid-template-columns:1fr;}}
.avatar{width:100%;aspect-ratio:1;border-radius:var(--radius);background:var(--bg-elev);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:4rem;font-weight:700;color:var(--accent);position:relative;overflow:hidden;}
.avatar::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(120deg,rgba(var(--accent-rgb),.06) 0 2px,transparent 2px 26px);}
.fact-list{margin-top:22px;display:flex;flex-direction:column;gap:12px;}
.fact-list li{display:flex;justify-content:space-between;font-size:.86rem;padding:10px 0;border-bottom:1px solid var(--border);color:var(--text-dim);}
.fact-list li b{color:var(--text);font-weight:500;}
.about-copy p{color:var(--text-dim);margin-bottom:18px;max-width:640px;}
.about-copy p b{color:var(--text);font-weight:600;}

/* =================== SKILLS =================== */
.skills-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:32px;}
.skill-group h3{font-size:1rem;margin-bottom:20px;color:var(--text);display:flex;align-items:center;gap:10px;}
.skill-group h3::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--accent);}
.skill-item{margin-bottom:16px;}
.skill-item .row{display:flex;justify-content:space-between;font-size:.84rem;margin-bottom:7px;}
.skill-item .row span:last-child{color:var(--text-dim);font-family:var(--font-mono);font-size:.76rem;}
.meter{height:6px;border-radius:4px;background:var(--bg-elev-2);overflow:hidden;}
.meter i{display:block;height:100%;width:0;border-radius:4px;background:linear-gradient(90deg,var(--accent),var(--accent-2));transition:width 1.1s cubic-bezier(.2,.8,.2,1);}

/* =================== PROJECTS =================== */
.project-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:26px;}
.card{
  background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius);
  padding:26px;transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease;
}
.card:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:rgba(var(--accent-rgb),.4);}
.card .metric{display:inline-block;font-family:var(--font-mono);font-size:.72rem;color:var(--accent);background:rgba(var(--accent-rgb),.1);padding:4px 10px;border-radius:20px;margin-bottom:14px;}
.card h3{font-size:1.15rem;margin-bottom:10px;}
.card p{color:var(--text-dim);font-size:.88rem;margin-bottom:18px;}
.tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;}
.tag{font-family:var(--font-mono);font-size:.7rem;padding:4px 9px;border:1px solid var(--border);border-radius:6px;color:var(--text-dim);}
.card-links{display:flex;gap:16px;}
.card-links a{font-size:.82rem;display:flex;align-items:center;gap:6px;color:var(--accent);font-weight:500;}
.card-links a:hover{text-decoration:underline;}

/* =================== TIMELINE (education) =================== */
.timeline{position:relative;max-width:760px;}
.timeline::before{content:"";position:absolute;top:6px;bottom:6px;left:118px;width:1.5px;background:var(--border);}
@media(max-width:600px){.timeline::before{left:10px;}}
.t-item{position:relative;display:grid;grid-template-columns:100px 1fr;gap:26px;padding-bottom:44px;}
@media(max-width:600px){.t-item{grid-template-columns:1fr;padding-left:28px;}
  .t-item .t-date{position:absolute;top:-22px;left:28px;}
}
.t-item:last-child{padding-bottom:0;}
.t-date{font-family:var(--font-mono);font-size:.78rem;color:var(--accent-2);text-align:right;padding-top:3px;}
@media(max-width:600px){.t-date{text-align:left;}}
.t-dot{position:absolute;left:112px;top:5px;width:13px;height:13px;border-radius:50%;background:var(--bg);border:2px solid var(--accent);}
@media(max-width:600px){.t-dot{left:4px;}}
.t-content h3{font-size:1.02rem;margin-bottom:6px;}
.t-content p{color:var(--text-dim);font-size:.86rem;}

/* =================== JOURNEY (horizontal) =================== */
.journey-track{display:grid;grid-auto-flow:column;grid-auto-columns:230px;gap:0;overflow-x:auto;padding:10px 4px 26px;position:relative;}
.journey-track::-webkit-scrollbar{height:8px;}
.j-step{position:relative;padding:0 20px 0 0;}
.j-step .j-line{position:absolute;top:20px;left:0;right:0;height:1.5px;background:var(--border);}
.j-step:first-child .j-line{left:20px;}
.j-num{width:40px;height:40px;border-radius:50%;background:var(--bg-elev);border:1.5px solid var(--accent);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:.8rem;color:var(--accent);position:relative;z-index:2;margin-bottom:18px;}
.j-step h4{font-size:.94rem;margin-bottom:6px;}
.j-step span{font-family:var(--font-mono);font-size:.72rem;color:var(--text-dim);}
.j-step p{font-size:.82rem;color:var(--text-dim);margin-top:6px;}

/* =================== LIVE DEMO =================== */
.demo-wrap{display:grid;grid-template-columns:1.3fr .9fr;gap:40px;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius);padding:34px;}
@media(max-width:860px){.demo-wrap{grid-template-columns:1fr;}}
#chartCanvas{width:100%;height:320px;display:block;}
.demo-controls{display:flex;flex-direction:column;gap:22px;}
.demo-controls label{font-size:.8rem;color:var(--text-dim);display:flex;justify-content:space-between;margin-bottom:8px;}
.demo-controls input[type=range]{width:100%;accent-color:var(--accent);}
.chip-toggle{display:flex;gap:10px;}
.chip-toggle button{flex:1;padding:9px;border-radius:8px;border:1px solid var(--border);font-size:.82rem;}
.chip-toggle button.active{background:var(--accent);color:#06181A;border-color:var(--accent);font-weight:600;}
.demo-note{font-size:.78rem;color:var(--text-dim);border-top:1px solid var(--border);padding-top:16px;}

/* =================== CONTACT =================== */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;}
@media(max-width:820px){.contact-grid{grid-template-columns:1fr;}}
.field{margin-bottom:20px;}
.field label{display:block;font-size:.78rem;color:var(--text-dim);margin-bottom:8px;}
.field input,.field textarea{
  width:100%;padding:13px 14px;background:var(--bg-elev);border:1px solid var(--border);border-radius:9px;
  color:var(--text);font-family:var(--font-body);font-size:.92rem;transition:border-color .25s;
}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--accent);}
.social-row{display:flex;gap:14px;margin-top:26px;}
.social-row a{width:42px;height:42px;border:1px solid var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;transition:border-color .25s,color .25s,transform .25s;}
.social-row a:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-3px);}
.form-status{font-size:.82rem;margin-top:6px;min-height:18px;color:var(--accent);}

footer{padding:36px 8vw;text-align:center;color:var(--text-dim);font-size:.8rem;border-top:1px solid var(--border);}
footer b{color:var(--accent);}

/* scroll reveal */
.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease, transform .7s ease;}
.reveal.in-view{opacity:1;transform:none;}

/* keyboard focus visibility */
a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}

@media (prefers-reduced-motion: reduce){
  *{animation:none !important;transition:none !important;}
  html{scroll-behavior:auto;}
}
</style>
</head>
<body>

<div class="cursor-dot" id="cursorDot"></div>
<div class="cursor-ring" id="cursorRing"></div>

