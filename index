</nav>

<!-- ============ HERO ============ -->
<section class="hero" id="home">
  <div class="hero-grid">
    <div>
      <p class="eyebrow">PW Skills Certified · Data Analyst</p>
      <h1>Turning raw data into <em>decisions</em> recruiters can act on.</h1>
      <p class="lede">I'm Aarav Sharma — I clean, model, and visualize data with Python, SQL, and BI tools to answer real business questions, fast.</p>
